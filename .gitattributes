# The schema tests parse these specs with 
-only patterns.
tests/fixtures/widget-specs/*.md text eol=lf
# Vitest cannot parse a shebang line that ends in CR.
tools/**/*.mjs text eol=lf
# Vitest writes snapshots with LF; a CRLF checkout shows them modified after every run.
*.snap text eol=lf
# Tauri regenerates these on every build with LF; a CRLF checkout shows them modified.
src-tauri/permissions/autogenerated/*.toml text eol=lf
# The parity fixtures are read by the Rust tests (ips-server/tests/parity*.rs); LF on every OS.
tests/fixtures/parity/*.json text eol=lf
tools/parity/*.mjs text eol=lf
# The optional pre-push hook is a shell script.
.githooks/* text eol=lf
# The recipe fixture packages are hashed byte for byte by their manifests (tools/widgets/recipe-fixtures.mjs): never converted.
tests/fixtures/recipes/** -text
# The signed widget fixtures are hashed and signed byte for byte (Phase 6a; FORMAT.md §17): never converted.
tests/fixtures/widgets/** -text
