{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recipe.schema.json",
  "title": "InfoPanel Studio recipe widget (recipe.json)",
  "description": "A widget made of Studio's blocks. Read by src/widgets/recipe/validate.ts, which adds the rules a schema cannot say (binding targets, the text floor, caps). No code and no URLs anywhere.",
  "type": "object",
  "required": ["format", "id", "name", "version", "author", "size", "options", "presets", "root", "sample"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": 1 },
    "id": { "type": "string", "pattern": "^recipe:[a-z0-9][a-z0-9-]{0,47}$" },
    "name": { "type": "string", "minLength": 1, "pattern": "^[^<>]{1,60}$" },
    "version": { "$ref": "#/$defs/semver" },
    "author": { "type": "string", "minLength": 1, "pattern": "^[^<>]{1,80}$" },
    "description": { "type": "string", "pattern": "^[^<>]{0,400}$" },
    "icon": { "$ref": "#/$defs/word" },
    "category": { "type": "string", "pattern": "^[A-Za-z][A-Za-z ]{0,23}$" },
    "size": {
      "type": "object",
      "required": ["min", "max", "default"],
      "additionalProperties": false,
      "properties": { "min": { "$ref": "#/$defs/cells" }, "max": { "$ref": "#/$defs/cells" }, "default": { "$ref": "#/$defs/cells" } }
    },
    "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
    "presets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/preset" } },
    "root": { "$ref": "#/$defs/block" },
    "sample": {
      "type": "object",
      "required": ["sensors"],
      "additionalProperties": false,
      "properties": {
        "sensors": { "type": "object", "additionalProperties": { "type": ["string", "number"] } },
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "object", "additionalProperties": { "type": ["string", "number", "array"], "items": { "type": "number" } } }
          }
        }
      }
    }
  },
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})(-[0-9A-Za-z.-]{1,20})?$" },
    "word": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$" },
    "key": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
    "cells": { "type": "array", "minItems": 2, "items": { "type": "number", "minimum": 1, "maximum": 12 } },
    "scale": { "type": "number", "minimum": 0.5, "maximum": 6 },
    "colour": { "enum": ["accent", "series-1", "series-2", "series-3", "series-4", "series-5", "series-6", "thresholds"] },
    "thresholds": {
      "type": "object",
      "required": ["warn", "crit"],
      "additionalProperties": false,
      "properties": { "warn": { "type": "number" }, "crit": { "type": "number" } }
    },
    "binding": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "sensor": { "type": "string", "minLength": 1 },
        "option": { "$ref": "#/$defs/key" },
        "field": { "$ref": "#/$defs/key" }
      }
    },
    "condition": {
      "type": "object",
      "required": ["option"],
      "additionalProperties": false,
      "properties": { "option": { "$ref": "#/$defs/key" }, "is": { "type": ["string", "number", "boolean"] }, "not": { "type": ["string", "number", "boolean"] } }
    },
    "place": {
      "type": "object",
      "required": ["name", "lat", "lon"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[^<>]{1,60}$" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "option": {
      "type": "object",
      "required": ["key", "label", "type", "default"],
      "additionalProperties": false,
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "type": "string", "pattern": "^[^<>]{1,40}$" },
        "type": { "enum": ["text", "number", "select", "boolean", "color", "sensor", "date", "time", "place-list"] },
        "default": { "type": ["string", "number", "boolean", "array"], "items": { "$ref": "#/$defs/place" } },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "additionalProperties": false,
            "properties": { "value": { "type": "string" }, "label": { "type": "string", "pattern": "^[^<>]{1,40}$" } }
          }
        },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "minimum": 0 },
        "hint": { "type": "string", "pattern": "^[^<>]{0,160}$" },
        "group": { "type": "string", "pattern": "^[^<>]{1,40}$" }
      }
    },
    "preset": {
      "type": "object",
      "required": ["id", "name", "settings", "size"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/word" },
        "name": { "type": "string", "pattern": "^[^<>]{1,40}$" },
        "settings": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "size": { "$ref": "#/$defs/cells" },
        "minSize": { "$ref": "#/$defs/cells" },
        "blurb": { "type": "string", "pattern": "^[^<>]{1,60}$" },
        "tags": { "type": "string", "pattern": "^[a-z0-9 ]{0,120}$" },
        "default": { "const": true }
      }
    },
    "block": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["card", "row", "repeat", "ring", "gauge", "bar", "sparkline", "value", "label", "weather-icon", "image", "heatmap"] },
        "name": { "type": "string", "pattern": "^[^<>]{1,40}$" },
        "when": { "$ref": "#/$defs/condition" },
        "grow": { "type": "number", "minimum": 0, "maximum": 12 },
        "children": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "title": { "type": "string", "pattern": "^[^<>]{1,60}$" },
        "subtitle": { "$ref": "#/$defs/binding" },
        "icon": { "$ref": "#/$defs/word" },
        "direction": { "enum": ["row", "column", "rows", "columns", "grid"] },
        "gap": { "type": "number", "minimum": 0, "maximum": 24 },
        "align": { "enum": ["start", "center", "end", "stretch"] },
        "over": { "$ref": "#/$defs/key" },
        "source": { "enum": ["weather-by-place"] },
        "max": { "type": "number" },
        "min": { "type": "number" },
        "dividers": { "type": "boolean" },
        "bind": { "$ref": "#/$defs/binding" },
        "cells": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binding" } },
        "color": { "$ref": "#/$defs/colour" },
        "thresholds": { "$ref": "#/$defs/thresholds" },
        "center": { "type": "boolean" },
        "scale": { "$ref": "#/$defs/scale" },
        "thickness": { "type": "number", "minimum": 2, "maximum": 24 },
        "unit": { "type": "string", "pattern": "^[^<>]{0,8}$" },
        "decimals": { "type": "number", "minimum": 0, "maximum": 4 },
        "style": { "enum": ["bar", "segments", "line", "area", "bars"] },
        "label": { "type": "string", "pattern": "^[^<>]{1,40}$" },
        "text": { "type": "string", "pattern": "^[^<>]{1,80}$" },
        "tone": { "enum": ["fg", "muted", "accent"] },
        "file": { "type": "string", "pattern": "^images/[a-z0-9][a-z0-9-]{0,63}\\.(png|jpg|webp)$" },
        "fit": { "enum": ["contain", "cover"] },
        "alt": { "type": "string", "pattern": "^[^<>]{0,80}$" },
        "columns": { "type": "number", "minimum": 1, "maximum": 24 }
      }
    }
  }
}
