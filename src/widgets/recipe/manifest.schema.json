{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "InfoPanel Studio widget package manifest (manifest.json)",
  "description": "One manifest for recipe widgets (Phase 5a) and code widgets (Phase 6a): the package's identity and every file with its SHA-256. A recipe has no signature; 6a signs this object without its signature field, so the file hashes are signed with it.",
  "type": "object",
  "required": ["format", "kind", "id", "version", "author", "files"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": 1 },
    "kind": { "enum": ["recipe", "code"] },
    "id": { "type": "string", "pattern": "^(recipe:[a-z0-9][a-z0-9-]{0,47}|ext:[a-z0-9][a-z0-9-]{0,31}\\.[a-z0-9][a-z0-9-]{0,47})$" },
    "version": { "type": "string", "pattern": "^(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})\\.(0|[1-9]\\d{0,5})(-[0-9A-Za-z.-]{1,20})?$" },
    "author": { "type": "string", "pattern": "^[^<>]{1,80}$" },
    "name": { "type": "string", "pattern": "^[^<>]{1,60}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^(recipe\\.json|images/[a-z0-9][a-z0-9-]{0,63}\\.(png|jpg|webp))$" },
          "bytes": { "type": "number", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "signature": { "type": "object" }
  }
}
