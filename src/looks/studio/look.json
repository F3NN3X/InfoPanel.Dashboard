          "soon"
        ]
      },
      "text-soft": {
        "value": "#a1a1aa",
        "usage": "Secondary text and edges the studio used as hex literals (FND-030): one step each, not near-duplicates.",
        "s": [
          "soft"
        ]
      }
    },
    "status": {
      "ok": {
        "value": "{ok}"
      },
      "warn": {
        "value": "{warn}"
      },
      "danger": {
        "value": "{crit}"
      },
      "info": {
        "value": "{info}"
      }
    },
