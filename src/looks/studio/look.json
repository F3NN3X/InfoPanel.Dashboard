{
  "$schema": "../look.schema.json",
  "schema": 1,
  "id": "studio",
  "name": "Studio",
  "description": "The built-in Look of the studio, Settings and Help chrome: zinc panels, a blue accent. Not editable; panel Looks never fill its studio block (D1).",
  "tags": [
    "studio",
    "dark"
  ],
  "modes": {
    "supported": [
      "dark"
    ],
    "stance": "Dark only (D3): the studio, Settings and Help are dark."
  },
  "fonts": {
    "body": "Geist",
    "mono": "Geist Mono",
    "display": "{body}"
  },
  "radius": "8px",
  "t1": {
    "dark": {
      "bg": {
        "value": "#09090b",
        "usage": "App window"
      },
      "surface": {
        "value": "#111114",
        "usage": "Panels and cards"
      },
      "surface-2": {
        "value": "#17171b",
        "usage": "Tiles"
      },
      "fg": {
        "value": "#ededf0",
        "usage": "Primary text"
      },
      "fg-2": {
        "value": "#a1a1aa",
        "usage": "Secondary text"
      },
      "muted": {
        "value": "#8a8a95",
        "usage": "Muted: hints, labels, meta and icons (4.5:1 on panels and cards)"
      },
      "border": {
        "value": "#1f1f24",
        "usage": "Dividers"
      },
      "border-soft": {
        "value": "{border}",
        "usage": "Hairlines"
      },
      "accent": {
        "value": "#6ea8ff",
        "usage": "The studio accent: selection, focus, the active tab, links. Nothing else"
      },
      "accent-on": {
        "value": "{bg}",
        "usage": "Text on an accent fill"
      },
      "accent-hover": {
        "value": "{accent}",
        "usage": "Hover on an accent fill"
      },
      "focus-ring": {
        "value": "{accent}",
        "usage": "Focus outline"
      },
      "ok": {
        "value": "#3fcf8e",
        "usage": "Status ok"
      },
      "warn": {
        "value": "#f2b23a",
        "usage": "Status warning"
      },
      "crit": {
        "value": "#f07070",
        "usage": "Status danger"
      },
      "info": {
        "value": "oklch(0.78 0.09 205)",
        "usage": "Status info, away from the accent hue (255)"
      }
    }
  },
  "studio": {
    "shared": {
      "bg-app": {
        "value": "{bg}",
        "s": [
          "win"
        ]
      },
      "bg-panel": {
        "value": "{surface}",
        "s": [
          "card"
        ]
