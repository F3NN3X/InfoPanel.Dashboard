          "side"
        ]
      },
      "border-card": {
        "value": "#1f1f24",
        "s": [
          "code-line"
        ]
      },
      "live": {
        "value": "{ok}",
        "usage": "Kiosk-live green (the Live pill and the Shown-on-kiosk icon), saved and tuned dots.",
        "s": [
          "tip"
        ]
      },
      "accent-text": {
        "value": "{accent}",
        "s": [
          "accent-text"
        ]
      },
      "text-warn": {
        "value": "{warn}",
        "s": [
          "warn-text"
        ]
      },
      "dot-profile": {
        "value": "oklch(0.74 0.13 300)",
