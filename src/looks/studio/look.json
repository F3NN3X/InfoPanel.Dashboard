          "hover",
          "side-line",
          "divider",
          "nav-on"
        ]
      },
      "border-subtle": {
        "value": "{border}",
        "s": [
          "card-line"
        ]
      },
      "border-menu": {
        "value": "#2a2a31",
        "s": [
          "menu"
        ]
      },
      "border-control": {
        "value": "#6c6c76",
        "s": [
          "input-line",
          "track-line"
        ],
        "usage": "Boundaries of controls that carry meaning (fields, checkboxes, segmented, switch tracks, drag handles): 3:1 on every panel. Button and card hairlines use border-menu or border-strong."
