+/** Last resolved settings per placement: the same values keep the same object, so a zone's look can be memoised on it. */
+const resolvedByPlacement = new WeakMap<Placement, ModuleSettings | undefined>();
+function stableSettings(p: Placement, next: ModuleSettings | undefined): ModuleSettings | undefined {
+  const prev = resolvedByPlacement.get(p);
+  const same = prev === next || (!!prev && !!next && Object.keys(prev).length === Object.keys(next).length && Object.keys(next).every((k) => prev[k] === next[k]));
